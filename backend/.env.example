SECRET_KEY=change-me-generate-random-string
DEBUG=True
# Прод: ALLOWED_HOSTS=wishlist.example.com
ALLOWED_HOSTS=localhost,127.0.0.1
# Прод: CSRF_TRUSTED_ORIGINS=https://wishlist.example.com
# CSRF_TRUSTED_ORIGINS=
POSTGRES_DB=wishlist
POSTGRES_USER=wishlist
POSTGRES_PASSWORD=wishlist
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
# Username бота без @ — для ссылок https://t.me/<username>?startapp=<token>
# TELEGRAM_BOT_USERNAME=YourWishlistBot
# Админы Mini App (tg id через запятую). По умолчанию 425606812
# ADMIN_TELEGRAM_USER_IDS=425606812
# JWT (подпись access/refresh; сгенерируй длинную случайную строку, не коммить реальное значение)
JWT_SECRET=change-me-generate-long-random-string
# Опционально (секунды); если не заданы — дефолты из README: 3600 / 2592000
# JWT_ACCESS_TTL_SEC=3600
# JWT_REFRESH_TTL_SEC=2592000
# GUNICORN_WORKERS=1
# GUNICORN_THREADS=2
